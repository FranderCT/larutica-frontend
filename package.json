{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "runtime:check": "node scripts/check-runtime.mjs",
    "predev": "node scripts/check-runtime.mjs && node scripts/prepare-local-env.mjs && node scripts/prepare-map-worker.mjs",
    "dev": "vinext dev",
    "prebuild": "node scripts/check-runtime.mjs && node scripts/prepare-map-worker.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/auth-contract.test.mjs tests/privacy-consent.test.mjs tests/privacy-api.test.mjs tests/remote-proxy.test.mjs tests/reservations-contract.test.mjs tests/booking-return.test.mjs tests/traveler-saved-rating.test.mjs tests/browser-fetch.test.mjs tests/analytics-reservations.test.mjs && npm run test:payments && npm run test:mail",
    "test:payments": "node --import ./tests/mail/register.mjs --test tests/payments.test.mjs",
    "test:mail": "node --experimental-strip-types --test tests/trip-email.test.mjs tests/mail/transport.test.mjs tests/mail/cli.test.mjs tests/mail/relay.test.mjs && node --import ./tests/mail/register.mjs --test tests/mail/flows.test.mjs tests/mail/diagnostic.test.mjs tests/mail/payments-flow.test.mjs tests/mail/admin-payments.test.mjs",
    "design:check": "node scripts/check-design.mjs",
    "mail:check": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/mail-check.mjs",
    "test:booking:integration": "node --env-file-if-exists=.env.local --test tests/booking.integration.mjs",
    "test:auth:cloud": "node --env-file-if-exists=.env.local --test tests/supabase-auth.integration.mjs",
    "test:maps": "node --import ./tests/maps/register.mjs --test tests/maps/routing.test.mjs",
    "test:maps:e2e": "playwright test --config playwright.maps.config.ts",
    "test:maps:runtime": "playwright test --config playwright.maps.runtime.config.ts",
    "test:maps:live": "node --env-file-if-exists=.env.local --import ./tests/maps/register.mjs --test tests/maps/live.integration.mjs",
    "test:auth:e2e": "node --env-file-if-exists=.env.local --test tests/opaque-session.integration.mjs",
    "security:verify": "npm audit signatures && npm audit --omit=dev",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "build:vercel": "node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.2",
    "@supabase/supabase-js": "2.57.4",
    "@tanstack/react-form": "^1.33.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "libphonenumber-js": "1.13.14",
    "lucide-react": "^1.34.0",
    "maplibre-gl": "6.15.0",
    "nodemailer": "10.1.7",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-phone-number-input": "^3.4.18",
    "sweetalert2": "11.26.25",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "nitro": "3.0.260903-beta",
    "react-server-dom-webpack": "19.2.6",
    "smtp-server": "3.20.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
